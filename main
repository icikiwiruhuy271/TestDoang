--// TAB UNTUK SISTEM KUNCI
local KeyTab = Window:Tab({
    Title = "loc:KEY_TAB_TITLE",
    Icon = "key",
    Locked = false
})
KeyTab:Select()

local KeyInput = KeyTab:Input({
    Title = "loc:KEY_TAB_TITLE",
    Desc = "loc:KEY_INPUT_DESC",
    Value = "",
    InputIcon = "key",
    Type = "Input",
    Placeholder = "joyhub-xxxx",
    Callback = function() end
})

KeyTab:Divider()

KeyTab:Button({
    Title = "loc:GET_LINK_BUTTON_TITLE",
    Desc = "loc:GET_LINK_BUTTON_DESC",
    Icon = "link",
    Callback = function()
        local success, result = GetSafelinkuLink()
        if success then
            if setclipboard then
                NotifyPesan("loc:NOTIFY_LINK_COPIED", "berhasil")
            else
                NotifyPesan("loc:NOTIFY_LINK_COPIED", "info", " " .. result)
            end
        else
            NotifyPesan("loc:NOTIFY_LINK_FAIL", "gagal", tostring(result))
        end
    end
})

KeyTab:Button({
    Title = "loc:SUBMIT_KEY_BUTTON_TITLE",
    Desc = "loc:SUBMIT_KEY_BUTTON_DESC",
    Icon = "check-circle",
    Callback = function()
        local key = KeyInput.Value:gsub("%s+", "")
        if key == "" then
            NotifyPesan("loc:NOTIFY_ENTER_KEY", "error")
            return
        end

        Window:Close()

        NotifyPesan("loc:NOTIFY_VALIDATING", "info")

        task.spawn(function()
            local isValid, err = ValidateKeyWithAPI(key)

            if isValid == true then
                SaveKey(key)
                NotifyPesan("loc:NOTIFY_VALID_SUCCESS", "berhasil")
                Window:Destroy()
                main()
            else
                DeleteKey()
                if isValid == false then
                    NotifyPesan("loc:NOTIFY_INVALID_KEY", "error")
                else
                    NotifyPesan("loc:NOTIFY_VALID_FAIL", "error", tostring(err))
                end
                Window:Open()
            end
        end)
    end
})

Window:Divider()

