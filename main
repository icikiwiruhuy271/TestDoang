--// FUNGSI UNTUK MENDAPATKAN TEKS TERJEMAHAN BERDASARKAN BAHASA SISTEM
local function getText(key)
    local success, locale = pcall(function()
        return LocalizationService:GetLocale()
    end)
    local lang = "en"
    if success and locale then
        lang = locale:sub(1,2):lower()
    end
    if not Translations[lang] then
        lang = "en"
    end
    return Translations[lang][key] or Translations["en"][key] or key
end

--// KONFIGURASI LOKALISASI WINDUI
WindUI:Localization({
    Enabled = true,
    Prefix = "loc:",
    DefaultLanguage = "en",
    Translations = Translations
})

--// FUNGSI UNTUK MENYIMPAN KUNCI (KEY) SECARA LOKAL
local function SaveKey(key)
    if writefile then
        pcall(function()
            if not isfolder("JoyHub") then
                makefolder("JoyHub")
            end
            writefile("JoyHub/key_JoyHub.txt", key)
        end)
    end
end

--// FUNGSI UNTUK MEMUAT KUNCI YANG TERSIMPAN
local function LoadKey()
    if readfile and isfile then
        local success, result = pcall(function()
            if isfile("JoyHub/key_JoyHub.txt") then
                return readfile("JoyHub/key_JoyHub.txt")
            end
        end)
        if success and result then
            return result
        end
    end
    return nil
end

--// FUNGSI UNTUK MENGHAPUS KUNCI YANG TERSIMPAN
local function DeleteKey()
    if delfile and isfile then
        pcall(function()
            if isfile("JoyHub/key_JoyHub.txt") then
                delfile("JoyHub/key_JoyHub.txt")
            end
        end)
    end
end

--// FUNGSI UNTUK MEMERIKSA APAKAH PLAYER ADALAH OWNER
local function CheckOwner()
    local currentPlayer = LocalPlayer
    local currentUsername = currentPlayer.Name:lower()
    
    local success, response = pcall(function()
        return game:HttpGet(OWNER_LIST_URL, true)
    end)
    
    if not success then
        return false
    end
    
    local owners = {}
    for line in response:gmatch("[^\r\n]+") do
        local ownerName = line:gsub("%s+", ""):lower()
        if ownerName ~= "" then
            table.insert(owners, ownerName)
        end
    end
    
    if #owners == 0 then
        return false
    end
    
    for _, ownerName in ipairs(owners) do
        if currentUsername == ownerName then
            return true
        end
    end
    
    return false
end

--// FUNGSI UNTUK MEMVALIDASI KUNCI DENGAN API JUNKIE
local function ValidateKeyWithAPI(key)
    local success, result = pcall(function()
        local Junkie = loadstring(game:HttpGet("https://jnkie.com/sdk/JunkieKeySystem.lua"))()
        return Junkie.verifyKey(Config.api, key, Config.service)
    end)
    
    if success then
        return result
    else
        return false, "Layanan sedang tidak tersedia"
    end
end

--// FUNGSI UNTUK MENDAPATKAN LINK SAFELINKU
local function GetSafelinkuLink()
    local success, result = pcall(function()
        local Junkie = loadstring(game:HttpGet("https://jnkie.com/sdk/JunkieKeySystem.lua"))()
        return Junkie.getLink(Config.api, "JoyHub", Config.service)
    end)
    
    if success and result then
        if setclipboard then
            setclipboard(result)
            return true, result
        else
            return true, result
        end
    else
        return false, "Gagal mendapatkan link"
    end
end

--// FUNGSI NOTIFIKASI DENGAN TEKS TERJEMAHAN
local function NotifyPesan(key, jenis, extra)
    local content = getText(key)
    if extra then
        content = content .. extra
    end
    WindUI:Notify({
        Title = getText("loc:WINDOW_TITLE"),
        Content = content,
        Duration = 4
    })
end

--// FUNGSI UNTUK MEMBERSIHKAN UI LAMA JIKA ADA
local function CleanupExistingUI()
    if Window then
        pcall(function() Window:Destroy() end)
    end
end

--// CEK APAKAH PLAYER ADALAH OWNER (LANGSUNG JALANKAN SKRIP UTAMA)
if CheckOwner() then
    CleanupExistingUI()
    main()
    return
end

