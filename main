            end,
        }
    }
})

--// CEK KUNCI TERSIMPAN SAAT MULAI
local function CheckSavedKey()
    local savedKey = LoadKey()
    if savedKey then
        KeyInput.Value = savedKey
        NotifyPesan("loc:NOTIFY_CHECKING_SAVED", "info")
        
        task.spawn(function()
            local isValid = ValidateKeyWithAPI(savedKey)
            if isValid == true then
                task.wait(1)
                NotifyPesan("loc:NOTIFY_SAVED_VALID", "berhasil")
                task.wait(1)
                Window:Destroy()
                main()
            else
                DeleteKey()
                KeyInput.Value = ""
                NotifyPesan("loc:NOTIFY_SAVED_EXPIRED", "peringatan")
                Window:Open()
            end
        end)
    else
        Window:Open()
    end
end

task.wait(0.5)
CheckSavedKey()

